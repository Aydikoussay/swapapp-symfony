{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin{% endblock %}

{% block body %}
<h1>Dashboard Admin</h1>

<!-- KPI CARDS -->
<div style="display:flex; gap:20px; margin-bottom:30px;">
    <div class="card">👤 Users<br><strong>{{ totalUsers }}</strong></div>
    <div class="card">📦 Articles<br><strong>{{ totalArticles }}</strong></div>
    <div class="card">🔁 Requests<br><strong>{{ totalRequests }}</strong></div>
</div>

<hr>

<!-- CHARTS -->
<div style="display:grid; grid-template-columns: 1fr 1fr; gap:40px;">

    <div>
        <h3>Articles per Month</h3>
        <canvas id="articlesMonthChart"></canvas>
    </div>

    <div>
        <h3>Articles by Status</h3>
        <canvas id="articlesStatusChart"></canvas>
    </div>

    <div>
        <h3>Requests per Month</h3>
        <canvas id="requestsMonthChart"></canvas>
    </div>

    <div>
        <h3>Requests by Status</h3>
        <canvas id="requestsStatusChart"></canvas>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
/* Articles per month */
new Chart(document.getElementById('articlesMonthChart'), {
    type: 'line',
    data: {
        labels: {{ articlesByMonth|map(a => a.month)|json_encode|raw }},
        datasets: [{
            label: 'Articles',
            data: {{ articlesByMonth|map(a => a.count)|json_encode|raw }},
            borderWidth: 2
        }]
    }
});

/* Articles status */
new Chart(document.getElementById('articlesStatusChart'), {
    type: 'doughnut',
    data: {
        labels: {{ statusLabels|json_encode|raw }},
        datasets: [{
            data: {{ statusCounts|json_encode|raw }}
        }]
    }
});

/* Requests per month */
new Chart(document.getElementById('requestsMonthChart'), {
    type: 'bar',
    data: {
        labels: {{ requestsByMonth|map(r => r.month)|json_encode|raw }},
        datasets: [{
            label: 'Requests',
            data: {{ requestsByMonth|map(r => r.count)|json_encode|raw }}
        }]
    }
});

/* Requests status */
new Chart(document.getElementById('requestsStatusChart'), {
    type: 'pie',
    data: {
        labels: {{ requestsStatusLabels|json_encode|raw }},
        datasets: [{
            data: {{ requestsStatusCounts|json_encode|raw }}
        }]
    }
});
</script>

<style>
.card {
    padding:20px;
    border-radius:8px;
    background:#f5f5f5;
    text-align:center;
    flex:1;
    font-size:18px;
}
</style>
{% endblock %}
